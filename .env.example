# ==============================================================================
# Dunnify Environment Variables Template
# Copy this file to .env.local for local development or set in Vercel Project Settings
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="https://dunnify.com"

# Supabase Cloud Database & Auth (Mandatory)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Upstash QStash Serverless Message Queue (Phase 4 Scheduler)
# Optional in dev; messages fall back to Supabase DB queue & Vercel Cron sweeper
QSTASH_TOKEN="your-qstash-token"
QSTASH_URL="https://qstash.upstash.io/v2"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# Vercel Cron Secret (Secures /api/scheduler/dunning against unauthorized triggers)
CRON_SECRET="your-secure-random-cron-secret-32-chars"

# Stripe Webhook & Ingestion (Optional in test mode - simulated invoices work out of the box)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# WhatsApp Cloud API / Meta (Optional - falls back to production preview simulator)
META_WHATSAPP_TOKEN="EAAG..."
META_WHATSAPP_PHONE_NUMBER_ID="10065..."

# Resend Email (Fallback for subscribers without phone numbers)
RESEND_API_KEY="re_..."
